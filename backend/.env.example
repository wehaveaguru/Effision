# Leave SUPABASE_URL / SUPABASE_KEY unset to use the local SQLite dev shim
# (app/db/supabase_client.py) instead of a live Supabase project.
SUPABASE_URL=
SUPABASE_KEY=

LLAMA_CLOUD_API_KEY=
GROQ_API_KEY=

# Only used by docker-compose's local Postgres+pgvector service, if you
# want to test against real Postgres instead of the SQLite shim.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/product_brain

LOCAL_DB_PATH=data/local_dev.db